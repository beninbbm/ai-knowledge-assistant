# Copy to .env and adjust. All settings are read by backend/app/config.py.
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
TEST_DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag_test

OLLAMA_URL=http://localhost:11434
CHAT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text

# Used to sign login tokens. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me

UPLOAD_DIR=data/uploads
